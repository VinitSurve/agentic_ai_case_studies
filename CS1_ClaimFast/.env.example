# ==============================================================================
# ClaimFast – Groq API Credentials and Experiment Configuration
# ==============================================================================
# Add up to 3 authorized Groq API keys below.
# At least one non-empty key (GROQ_API_KEY_1) is required.
# Missing or empty keys are ignored safely without crashing.
# Copy this file to .env and insert your real credentials.
# NEVER commit the real .env file or expose real API keys!
# ==============================================================================

GROQ_API_KEY_1=gsk_your_first_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Central Model Configuration (Must remain constant across all 5 strategies & 3 runs)
# Recommended Groq production models supporting JSON Mode:
#   - llama-3.3-70b-versatile  (Default recommended for complex structured extraction)
#   - llama-3.1-70b-versatile
#   - llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Client Execution Parameters
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT=60
GROQ_REQUEST_DELAY=2.0

